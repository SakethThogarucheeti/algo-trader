from __future__ import annotations
import asyncio
from typing import Callable, Awaitable
from kiteconnect import KiteTicker


class ZerodhaStream:
    def __init__(
        self,
        api_key: str,
        access_token: str,
        on_tick: Callable[[dict], Awaitable[None]],
    ) -> None:
        self.loop = asyncio.get_event_loop()
        self.on_tick = on_tick

        self.kws = KiteTicker(api_key, access_token)

        self.kws.on_ticks = self._handle_ticks
        self.kws.on_connect = self._on_connect

        self._tokens: list[int] = []

    def set_tokens(self, tokens: list[int]) -> None:
        self._tokens = tokens

    def _on_connect(self, ws, response) -> None:
        ws.subscribe(self._tokens)
        ws.set_mode(ws.MODE_FULL, self._tokens)

    def _handle_ticks(self, ws, ticks) -> None:
        for tick in ticks:
            asyncio.run_coroutine_threadsafe(
                self.on_tick(tick),
                self.loop,
            )

    async def connect(self) -> None:
        # run in background thread
        await asyncio.to_thread(self.kws.connect)

    async def close(self) -> None:
        self.kws.close()